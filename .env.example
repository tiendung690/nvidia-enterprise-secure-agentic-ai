# Rotate every key/secret that has appeared in chat, logs, screenshots, or source control.
NVIDIA_API_KEY=nvapi-replace-me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.9
NVIDIA_MAX_TOKENS=2048
NVIDIA_REASONING_BUDGET=768
# Nemotron-3-Ultra managed endpoint hard ceiling observed by the provider. The runtime
# additionally subtracts NVIDIA_CONTEXT_SAFETY_TOKENS before exposing the window to LlamaIndex.
NVIDIA_CONTEXT_WINDOW=258048
NVIDIA_CONTEXT_SAFETY_TOKENS=8192
NVIDIA_ENABLE_THINKING=true
NVIDIA_FORCE_NONEMPTY_CONTENT=true
NVIDIA_MEDIUM_EFFORT=false
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=0
NVIDIA_EMBEDDING_MAX_RETRIES=1
PROVIDER_RETRY_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_SECONDS=1.5
PROVIDER_RETRY_MAX_SECONDS=20
PROVIDER_RETRY_JITTER=true
DIRECT_RAG_PROVIDER_DEADLINE_SECONDS=15
AGENT_PROVIDER_DEADLINE_SECONDS=45
PROVIDER_CIRCUIT_BREAKER_ENABLED=true
PROVIDER_CIRCUIT_BREAKER_FAILURES=5
PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=60
NVIDIA_EMBEDDING_BATCH_SIZE=16
NVIDIA_EMBEDDING_MAX_INPUT_TOKENS=512
NVIDIA_EMBEDDING_TOKEN_SAFETY_MARGIN=192
NVIDIA_EMBEDDING_TRUNCATE=END

AGENT_MODE=function
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENT_REQUESTS=2
AGENT_QUEUE_TIMEOUT_SECONDS=3
SESSION_CONCURRENCY_POLICY=reject
SESSION_LOCK_WAIT_TIMEOUT_SECONDS=5
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_SAME_TOOL_CALLS=1
AGENT_MAX_CALCULATOR_CALLS=3
AGENT_MAX_ANALYTICS_SAME_TOOL_CALLS=3
DETERMINISTIC_ROUTER_ENABLED=true
DIRECT_RAG_ENABLED=true
ENTERPRISE_FACTUAL_FAIL_CLOSED=true

DATA_DIR=/app/data
COURSE_DATA_DIR=/app/data/course
PAPERS_DATA_DIR=/app/data/papers
STORAGE_DIR=/app/storage
COURSE_RAG_TOP_K=6
PAPERS_RAG_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=4
COURSE_RAG_MIN_SCORE=0.30
PAPERS_RAG_MIN_SCORE=0.30
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
AUTO_INGEST=false

# Local development uses the checked-in security manifest and read-only JSON fixture.
# Set both backends to postgres for the enterprise Docker profile/database source of truth.
DOCUMENT_REGISTRY_BACKEND=json
DOCUMENT_SECURITY_MANIFEST=/app/data/security-manifest.json
REQUIRE_DOCUMENT_SECURITY_METADATA=true
OPERATIONAL_DATA_BACKEND=json
OPERATIONAL_ORDERS_FILE=/app/data/operational/orders.json

# Lakehouse gold analytics read path (ADR-020). The API reads only curated Delta gold
# serving tables via delta-rs; Spark stays in the medallion pipeline container.
# Seed locally with scripts/seed_lakehouse_gold_demo.py or sync from the DCEA export
# with scripts/sync_lakehouse_gold.py, then set ANALYTICS_BACKEND=delta.
ANALYTICS_BACKEND=disabled
DELTA_WAREHOUSE_ROOT=/app/data/lakehouse/dcea_medallion.db
DELTA_GOLD_CUSTOMER_SUMMARY_TABLE=gold_customer_order_summary
DELTA_GOLD_BOOK_SALES_TABLE=gold_book_sales_summary
ANALYTICS_TENANT_ID=tenant-a
ANALYTICS_MAX_ROWS=10
ANALYTICS_SNAPSHOT_TTL_SECONDS=60
DATABASE_URL=postgresql://agentic_app:agentic_app@postgres:5432/agentic_ai
DOCUMENT_REGISTRY_DATABASE_URL=postgresql://agentic_registry:agentic_registry@postgres:5432/agentic_ai

# Production must use AUTH_MODE=jwt and ALLOW_DEV_IDENTITY_HEADERS=false.
AUTH_MODE=dev
ALLOW_DEV_IDENTITY_HEADERS=true
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=enterprise-agentic-ai
JWT_JWKS_URL=
JWT_HS256_SECRET=replace-with-at-least-32-random-bytes-for-local-only
JWT_ALGORITHMS=["RS256","HS256"]
JWT_CLOCK_SKEW_SECONDS=30
JWT_TENANT_CLAIM=tenant_id
JWT_ROLES_CLAIM=roles
JWT_DEPARTMENTS_CLAIM=departments
JWT_CLEARANCE_CLAIM=clearance
JWT_AUTHORIZATION_VERSION_CLAIM=authz_version
DEFAULT_CLEARANCE=public
ENTERPRISE_POLICY_VERSION=enterprise-policy-v1
ALLOWED_PURPOSES=["learning","research","architecture-review","security-audit","customer-support","operations-review","business-analytics"]

# Context is minimized before hosted inference. Output is checked again before returning.
CONTEXT_MASKING_MODE=pseudonymize
MASKING_SALT=replace-with-a-secret-from-your-secret-manager
OUTPUT_DLP_MODE=redact
PROMPT_GUARD_MODE=block
INDIRECT_PROMPT_GUARD_MODE=audit
CITATION_VALIDATION_MODE=strict
CITATION_MINIMUM_COVERAGE=0.90
CITATION_REPAIR_MODE=conservative
CITATION_REPAIR_MAX_ATTEMPTS=1

ANSWER_BUDGET_SIMPLE_WORDS=300
ANSWER_BUDGET_COMPARISON_WORDS=700
ANSWER_BUDGET_LONG_WORDS=1200
ANSWER_BUDGET_SIMPLE_SOURCES=5
ANSWER_BUDGET_COMPARISON_SOURCES=8
ANSWER_BUDGET_LONG_SOURCES=10

RESPONSE_CACHE_TTL_SECONDS=1800
RESPONSE_CACHE_MAX_ENTRIES=1000
SESSION_TTL_SECONDS=3600
SESSION_MAX_ENTRIES=5000

AUDIT_BACKEND=jsonl
AUDIT_LOG_PATH=/app/storage/audit/security-audit.jsonl
ADMIN_TOKEN=replace-with-a-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO

# Host port can be changed when another local app already occupies 8000.
APP_PORT=8000

# v6 layered retrieval. Exact identifiers are retained; fusion is rank-based to avoid
# adding incomparable BM25 and cosine scores directly.
MULTI_QUERY_ENABLED=true
MULTI_QUERY_MAX_VARIANTS=3
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_RRF_K=60
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_FALLBACK_ENABLED=true
RETRIEVAL_QUALITY_HIGH_SCORE=0.72
RETRIEVAL_QUALITY_STANDARD_SCORE=0.45
RETRIEVAL_QUALITY_MINIMUM_COVERAGE=0.25
RETRIEVAL_QUALITY_FAIL_CLOSED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_MAX_ENTRIES=500

# Local/test may use memory; production validation requires postgres.
MEMORY_BACKEND=memory
MEMORY_DATABASE_URL=postgresql://agentic_app:agentic_app@postgres:5432/agentic_ai
MEMORY_EXACT_LIMIT=50
MEMORY_SEMANTIC_LIMIT=6
MEMORY_PROMPT_MAX_CHARS=8000
MEMORY_AUTO_CAPTURE_PREFERENCES=true

# A fresh workflow context is used per request and only this bounded projection is reassembled.
CONVERSATION_CONTEXT_MODE=bounded
CONVERSATION_RECENT_TURNS=4
CONVERSATION_MAX_CHARS=12000

# Local may use JSONL; production validation requires postgres.
TRACE_BACKEND=jsonl
TRACE_LOG_PATH=/app/storage/traces/agent-runs.jsonl
TRACE_RETENTION_DAYS=30

# Retention/erasure jobs require a separate privileged role with BYPASSRLS.
# Never expose this URL to the application container in production.
MAINTENANCE_DATABASE_URL=postgresql://maintenance-user:replace-me@postgres:5432/agentic_ai
OUTBOX_JSONL_PATH=/app/storage/outbox/events.jsonl

# --- v6.2 governance additions ---

# Tiered model gateway (ADR-018). If FAST model is empty, v6.2.1 uses the primary
# model with thinking disabled and NVIDIA_FAST_MAX_TOKENS as a fast synthesis profile.
# Configure a distinct smaller hosted model when your account has one available.
MODEL_TIER_ROUTING_ENABLED=true
NVIDIA_FAST_LLM_MODEL=
NVIDIA_FAST_MAX_TOKENS=1024
# Leave empty when the fast lane reuses the primary model. Set explicitly for a distinct model.
NVIDIA_FAST_CONTEXT_WINDOW=
GATEWAY_DEGRADE_TO_FAST=true

# Opt-in: escalate empty-evidence direct RAG to the bounded agent lane before failing closed.
# Trades tokens for recall; see ADR-019 before enabling in production.
CROSS_LANE_ESCALATION_ENABLED=false

# Per-tenant daily budgets (0 disables). Requests count all lanes; tokens count LLM lanes.
TENANT_DAILY_REQUEST_BUDGET=0
TENANT_DAILY_TOKEN_BUDGET=0
