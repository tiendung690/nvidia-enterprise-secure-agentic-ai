digraph G {
  graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.7];
  node [shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#3B4A5A", fontname="Arial", fontsize=10];
  edge [color="#526273", fontname="Arial", fontsize=9];
  user [label="End User / API Client"];
  identity [label="JWT Identity + Purpose"];
  guard [label="Query Policy + Prompt Guard"];
  exact [label="Exact Memory Read\nPolicy + Preference"];
  transform [label="Guarded Multi-Query"];
  vector [label="Vector Retrieval"];
  lexical [label="BM25 / Lexical Retrieval"];
  fusion [label="RRF Fusion"];
  rerank [label="Deterministic Reranker"];
  quality [label="Corrective Quality Gate\n+ Bounded Fallback"];
  broker [label="Secure Context Broker\nAuthorization before LLM"];
  conversation [label="Bounded Recent Conversation"];
  prompt [label="Bounded Prompt Assembly"];
  agent [label="Bounded Agent Runtime"];
  provider [label="NVIDIA Gateway\nRetry + Circuit Breaker"];
  tools [label="Typed Read-Only Tools"];
  output [label="Output DLP + Citation Postcondition"];
  response [label="Typed Response"];
  trace [label="Replayable Run Trace", shape=cylinder, fillcolor="#FFF4DA"];
  promote [label="Explicit Promotion API"];
  gate [label="Promotion Gate\nScope + Provenance + Confidence"];
  memory [label="Typed Durable Memory", shape=cylinder, fillcolor="#E5F6EA"];
  outbox [label="Transactional Outbox", shape=cylinder, fillcolor="#E5F6EA"];

  user -> identity -> guard;
  guard -> exact;
  guard -> transform;
  transform -> vector;
  transform -> lexical;
  vector -> fusion;
  lexical -> fusion;
  fusion -> rerank -> quality -> broker;
  exact -> prompt;
  broker -> prompt;
  conversation -> prompt;
  prompt -> agent;
  agent -> provider;
  agent -> tools;
  provider -> output;
  tools -> output;
  output -> response;
  response -> trace;
  response -> promote -> gate;
  gate -> memory;
  gate -> outbox;
  memory -> exact;
}
